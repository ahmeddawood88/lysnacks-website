---
import { navLinks, instagram } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav aria-label="Footer">
      <ul class="footer-nav">
        {navLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <a class="instagram" href={instagram.url} rel="noopener" target="_blank">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
      </svg>
      <span>{instagram.handle}</span>
      <span class="visually-hidden">(opens Instagram in a new tab)</span>
    </a>

    <p class="copyright">&copy; {year} L&amp;Y Snacks LLC &middot; Sacramento, California</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    background: var(--color-ly-green-deep);
    color: var(--color-cream);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-4);
  }

  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .site-footer a {
    color: var(--color-cream);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-1);
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer :focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .site-footer .instagram {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
  }

  .copyright {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .copyright {
      grid-column: 1 / -1;
    }
  }
</style>
